# ============ VoxDub Studio — cấu hình ============
# Chép tệp này thành .env rồi điền giá trị, hoặc chỉnh thẳng trong trang Cài
# đặt của ứng dụng (khuyên dùng — mọi mục dưới đây đều có ô riêng ở đó).

# --- Mức chất lượng tổng thể (một nút vặn cho tất cả) ---
# fast     = ưu tiên tốc độ
# balanced = khuyên dùng: nhạc nền 44.1 kHz, dịch hai lượt, ASR tự chọn
# quality  = tốt nhất, chạy chậm hơn
# Các mục chi tiết bên dưới nếu điền sẽ GHI ĐÈ mức chất lượng.
QUALITY_PRESET=balanced

# --- Nghe và chép lời video gốc (chạy trên máy, miễn phí) ---
# auto (khuyên dùng: large-v3 khi có card đồ họa, medium khi chỉ có CPU)
# hoặc tiny / base / small / medium / large-v3
WHISPER_MODEL=auto
# Bộ nhận dạng: whisper (mặc định, mọi ngôn ngữ) | paraformer (tiếng Trung,
# chính xác hơn, chạy CPU — cài một lần: py scripts/setup_paraformer.py)
ASR_ENGINE=whisper
DEFAULT_SOURCE_LANG=zh-CN
# Beam size của Whisper (1–10, trống = 5, giữ nguyên chất lượng). Máy chỉ có
# CPU muốn nhanh gấp 2–3 lần có thể đặt 1 — đổi lại kém chính xác hơn một chút.
WHISPER_BEAM_SIZE=

# --- OCR phụ đề cứng tiếng Trung (PaddleOCR local, tùy chọn) ---
OCR_ENABLED=true
OCR_DEVICE=auto
OCR_MIN_CONFIDENCE=0.80
OCR_MAX_REGION_AREA=0.25
OCR_SAMPLE_INTERVAL=1.0

# --- Giọng đọc tiếng Việt (VieNeu — bộ giọng duy nhất) ---
# Cài một lần:        py scripts/setup_vieneu.py
# Nạp thêm giọng mẫu: py scripts/setup_voices.py
# Tên giọng mặc định cho dự án mới. Xem danh sách đầy đủ, có bộ lọc theo giới
# tính / vùng miền / quốc gia, trong trang Cài đặt, thẻ Âm thanh.
VIENEU_VOICE=Phạm Tuyên
# Phong cách đọc: tu_nhien | tin_tuc | doc_truyen
VIENEU_STYLE=tu_nhien
# Số giọng chạy song song (mỗi luồng khoảng 1,5 GB bộ nhớ). Trống = tự chọn
VIENEU_MAX_WORKERS=
# Clone giọng theo từng job: có thể bật trong bước "Giọng đọc & phụ đề".
VIENEU_CLONE_ENABLED=false
VIENEU_CLONE_SOURCE=video
VIENEU_CLONE_REFERENCE_AUDIO=
VIENEU_CLONE_MIN_SECONDS=1.0
VIENEU_CLONE_MAX_SECONDS=8.0
# Số việc chạy cùng lúc cho các bước nặng. Trống = tự chọn theo CPU
PARALLEL_WORKERS=

# --- Dịch tự động ---
# Dịch tự động bắt buộc dùng endpoint + API key + model bên dưới.
TRANSLATE_ENABLED=true
TRANSLATION_ENDPOINT=https://api.example.com/v1
TRANSLATION_API_KEY=your-api-key
TRANSLATION_MODEL=
BILIBILI_COOKIES_FILE=
# Số câu gửi mỗi lượt (1–100). Lô nhỏ hơn bám ngữ cảnh sát hơn một chút.
TRANSLATE_BATCH_SIZE=10
# Dịch ba lượt: lượt 0 tự đọc hiểu video (tóm tắt, xưng hô, thuật ngữ) để
# dịch nhất quán; lượt chính; lượt rà soát dịch lại các câu nghi vấn.
# Hai lượt phụ đều gọi thêm mô hình — tắt đi nếu muốn nhanh và rẻ hơn.
TRANSLATE_ANALYSIS=true
TRANSLATE_REVIEW=true

# --- Ngữ cảnh video (giúp dịch chuẩn hơn — đều KHÔNG bắt buộc) ---
# Chủ đề video, vd: review công nghệ | phim cổ trang | vlog ẩm thực
TRANSLATE_DOMAIN=
# Mô tả kênh hoặc video (nhiều dòng thì dùng \n)
TRANSLATE_CONTEXT=
# Quy ước xưng hô, vd: mình – các bạn | tôi – anh em | huynh – muội
TRANSLATE_PRONOUNS=
# Thuật ngữ cố định, mỗi dòng "gốc = dịch" (dùng \n giữa các dòng)
TRANSLATE_GLOSSARY=
# Yêu cầu khác về giọng điệu và văn phong
TRANSLATE_STYLE_NOTES=

# --- Tốc độ và căn thời gian ---
# Tốc độ VIDEO: làm chậm cả video để giọng Việt (dài hơn khoảng 20%) đủ chỗ.
# 0.82 = video dài thêm khoảng 22%. 1.0 = giữ nguyên. Chồng tiếng thì giảm.
VIDEO_SPEED=1.0
# Tốc độ GIỌNG ĐỌC: áp cố định cho MỌI câu (1.0 = tự nhiên, 1.2 = nhanh 20%)
VOICE_SPEED=1.0
# Ngân sách dịch (số ký tự trên mỗi giây đọc). Nhỏ hơn = câu dịch ngắn hơn
TRANSLATE_CPS_BUDGET=12.5
# Chống chồng tiếng mềm: câu tràn chỗ thì DỒN TRỄ câu sau vào khoảng lặng
# (tốc độ đọc không đổi); chỉ nén nhẹ khi hết đường.
SOFT_TIMING_FIT=true
TIMING_MAX_DRIFT_S=1.5
TIMING_MIN_GAP_S=0.12
TIMING_MAX_ATEMPO=1.1

# --- Chất lượng âm thanh ---
# Nhạc nền 44.1 kHz stereo thay vì 16 kHz mono — nghe trong, không bí
HQ_BACKGROUND=true
# Chuẩn hóa âm lượng và fade từng câu (mọi câu to đều nhau)
VOICE_POSTPROCESS=true
# Độ lớn giọng đọc, càng gần 0 thì càng to
VOICE_TARGET_LUFS=-16.0
# Nhạc nền tự nhỏ đi bấy nhiêu dB khi có giọng đọc (0 = tắt)
BG_DUCK_VOICE_DB=-7.0

# --- Phụ đề ---
# Kiểu được chọn sẵn khi tạo dự án mới:
#   none = không gắn, soft = tệp phụ đề rời, burn = ghi thẳng vào hình
SUBTITLE_MODE=none
# Bộ kiểu chữ dựng sẵn: clean | bold_yellow | box | tiktok | karaoke |
# cinema | custom. Chọn custom rồi tự chỉnh các mục bên dưới.
SUBTITLE_PRESET=clean
SUBTITLE_POSITION=bottom
SUBTITLE_FONT=Arial
SUBTITLE_FONT_SIZE=22
SUBTITLE_BOLD=true
SUBTITLE_MARGIN_V=40
SUBTITLE_OUTLINE=2
SUBTITLE_SHADOW=0
SUBTITLE_COLOR=#FFFFFF
SUBTITLE_OUTLINE_COLOR=#000000
# Nền sau chữ: none (chỉ viền) | box (khối nền mờ kiểu CapCut)
SUBTITLE_BOX=none
SUBTITLE_BOX_COLOR=#000000
SUBTITLE_BOX_OPACITY=60
# Số chữ mỗi hàng: 0 = tự ngắt dòng. Video dọc nên đặt 4 tới 6.
SUBTITLE_LINE_WORDS=0
SUBTITLE_MAX_LINES=2
SUBTITLE_ALL_CAPS=false
# Cách hiện: sentence (cả câu) | karaoke (cụm chữ nhảy theo giọng đọc)
SUBTITLE_DISPLAY=sentence
KARAOKE_WORDS_PER_CUE=3
# Hiệu ứng cụm chữ: pop | fade | karaoke (đổi màu theo lời) | none
KARAOKE_EFFECT=pop
KARAOKE_HIGHLIGHT_COLOR=#FFD54A
# Khớp mốc chữ THẬT bằng Whisper nghe lại giọng đọc (khoảng 30-60 giây mỗi
# video). false = ước lượng theo âm tiết, nhanh hơn.
KARAOKE_ALIGNMENT=true

# --- Nội dung đăng bài ---
# Nhờ máy chủ viết tiêu đề, mô tả và hashtag cho YouTube/TikTok/Facebook sau
# mỗi lần lồng tiếng. Chưa cấu hình máy chủ thì bước này tự bỏ qua.
GENERATE_METADATA=true

# --- Chung ---
OUTPUT_DIR=./output
# Tên hiện ở lời chào Trang chủ. Để trống thì dùng tên đăng nhập của máy.
DISPLAY_NAME=
# Tự dọn tệp trung gian ngay khi xuất video xong. Tiết kiệm đĩa, nhưng dự án
# đã dọn thì không sửa từng câu hay xuất lại được nữa.
AUTO_CLEAN_INTERMEDIATES=false

# --- Máy chủ dịch (TÙY CHỌN) ---
# Để TRỐNG = chạy thuần trên máy: nghe-chép, lồng tiếng, phụ đề, xuất video
# đều chạy offline; riêng bước dịch app ghi sẵn lời nhắc ra
# TRANSLATE_PENDING.txt để bạn dán vào ChatGPT/Gemini rồi lưu kết quả lại.
# Muốn dịch TỰ ĐỘNG thì tự dựng máy chủ theo control_server/README.md rồi
# điền địa chỉ vào đây, vd: http://localhost:3001
VOXDUB_API_URL=

# --- Cập nhật và hỗ trợ ---
# Kho GitHub chứa bản phát hành (dạng "chủ/kho") — dùng để báo khi có bản mới.
UPDATE_REPO=ttthanh2044/voxdub
# Nơi nhận báo lỗi và góp ý.
SUPPORT_URL=https://github.com/ttthanh2044/voxdub/issues
